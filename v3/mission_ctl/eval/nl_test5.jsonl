{"id": "F01", "cat": "back", "text": "Walk backwards 1.5 meters.", "expect": [[{"op": "walk", "direction": "backward", "distance_m": 1.5}]], "outcome": "execute"}
{"id": "F02", "cat": "back", "text": "Back up for 4 seconds.", "expect": [[{"op": "walk", "direction": "backward", "duration_s": 4}]], "outcome": "execute"}
{"id": "F03", "cat": "back", "text": "Step back 2 meters at 0.4 meters per second.", "expect": [[{"op": "walk", "direction": "backward", "distance_m": 2, "speed_mps": 0.4}]], "outcome": "execute"}
{"id": "F04", "cat": "back", "text": "Reverse for 5 seconds at 0.5 meters per second.", "expect": [[{"op": "walk", "direction": "backward", "duration_s": 5, "speed_mps": 0.5}]], "outcome": "execute"}
{"id": "F05", "cat": "refuse", "text": "Back up 3 meters at 0.9 meters per second.", "expect": [[{"op": "walk", "direction": "backward", "distance_m": 3, "speed_mps": 0.9}]], "outcome": "refuse", "why": "too_fast"}
{"id": "F06", "cat": "side", "text": "Sidestep to the right for 3 seconds.", "expect": [[{"op": "walk", "direction": "right", "duration_s": 3}]], "outcome": "execute"}
{"id": "F07", "cat": "side", "text": "Slide left 1 meter.", "expect": [[{"op": "walk", "direction": "left", "distance_m": 1}]], "outcome": "execute"}
{"id": "F08", "cat": "side", "text": "Shuffle to the right 0.8 meters at 0.3 meters per second.", "expect": [[{"op": "walk", "direction": "right", "distance_m": 0.8, "speed_mps": 0.3}]], "outcome": "execute"}
{"id": "F09", "cat": "side", "text": "Move sideways to the left for 4 seconds.", "expect": [[{"op": "walk", "direction": "left", "duration_s": 4}]], "outcome": "execute"}
{"id": "F10", "cat": "refuse", "text": "Strafe right 2 meters at 0.7 meters per second.", "expect": [[{"op": "walk", "direction": "right", "distance_m": 2, "speed_mps": 0.7}]], "outcome": "refuse", "why": "too_fast"}
{"id": "F11", "cat": "seq", "text": "Walk forward 2 meters, then walk backward 2 meters.", "expect": [[{"op": "walk", "direction": "forward", "distance_m": 2}, {"op": "walk", "direction": "backward", "distance_m": 2}]], "outcome": "execute"}
{"id": "F12", "cat": "seq", "text": "Strafe left 1 meter, then strafe right 1 meter.", "expect": [[{"op": "walk", "direction": "left", "distance_m": 1}, {"op": "walk", "direction": "right", "distance_m": 1}]], "outcome": "execute"}
{"id": "F13", "cat": "seq", "text": "Turn right 90 degrees, then back up 1 meter.", "expect": [[{"op": "turn", "direction": "right", "angle_deg": 90}, {"op": "walk", "direction": "backward", "distance_m": 1}]], "outcome": "execute"}
{"id": "F14", "cat": "seq", "text": "Back up 1 meter, stand still for 3 seconds, then walk forward 1 meter.", "expect": [[{"op": "walk", "direction": "backward", "distance_m": 1}, {"op": "stand", "duration_s": 3}, {"op": "walk", "direction": "forward", "distance_m": 1}]], "outcome": "execute"}
{"id": "F15", "cat": "turn", "text": "Turn left 180 degrees at 1.2 radians per second.", "expect": [[{"op": "turn", "direction": "left", "angle_deg": 180, "rate_rad_s": 1.2}]], "outcome": "execute"}
{"id": "F16", "cat": "refuse", "text": "Turn right 90 degrees at 1.5 radians per second.", "expect": [[{"op": "turn", "direction": "right", "angle_deg": 90, "rate_rad_s": 1.5}]], "outcome": "refuse", "why": "limits", "note": "1.05 s, under the 2 s floor"}
{"id": "F17", "cat": "refuse", "text": "Walk backward.", "expect": [[{"op": "walk", "direction": "backward"}]], "outcome": "refuse", "why": "no_amount"}
{"id": "F18", "cat": "refuse", "text": "Walk backward 1 meter and then sit down.", "expect": [[{"op": "walk", "direction": "backward", "distance_m": 1}, {"op": "unsupported", "what": "sit down"}]], "outcome": "refuse", "why": "unsupported"}
{"id": "F19", "cat": "side", "text": "Go left 2 meters.", "expect": [[{"op": "walk", "direction": "left", "distance_m": 2}]], "outcome": "execute", "note": "the prompt reads a walk to a side as sideways; the other reading, turn left then walk, is refused because nobody said 90 degrees. Either way the plan before [y/N] says which"}
{"id": "F20", "cat": "refuse", "text": "Take three steps back.", "expect": [[{"op": "walk", "direction": "backward"}]], "outcome": "refuse", "why": "no_amount", "note": "steps are not a unit"}
